# ─── Production Environment Variables for Vercel Deployment ──────────────────

# The public URL of your deployed Strapi backend on Render:
# (Replace with your actual Render service URL, e.g. https://congocheck-strapi.onrender.com)
NEXT_PUBLIC_STRAPI_API_URL=https://your-strapi-service.onrender.com

# Optional: If you created a Read-Only API Token in Strapi (Settings > API Tokens)
# Leave commented out or empty if using Public role permissions.
# NEXT_PUBLIC_STRAPI_API_TOKEN=your_strapi_api_token_here
